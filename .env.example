# Meta Model API key (get one at https://dev.meta.ai — every hackathon
# participant receives $150 in credits). Copy this file to `.env` and
# paste your key there; the server reads `.env` (git-ignored), never this file.
MODEL_API_KEY=your_meta_model_api_key_here

# Optional overrides
# META_BASE_URL=https://api.meta.ai/v1
# META_SPARK_MODEL=muse-spark-1.3
# META_SAM_MODEL=sam-3.1
# PORT=3001
